# ---------------------------------------------------------------------------
# RoleFit environment
#
# Copy to `.env` and fill in. Everything except DATABASE_URL/DIRECT_URL and
# AUTH_SECRET has a working fallback, so a fresh clone boots into demo mode
# without an Anthropic key or an OAuth app.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Local development needs no hosted database and no Docker. Run:
#
#   npm run db:start     # embedded Postgres on port 5433, data in ./.postgres
#   npm run db:migrate
#   npm run db:seed
#
# and use the two URLs below verbatim. Delete ./.postgres to start clean.
DATABASE_URL="postgresql://rolefit:rolefit@127.0.0.1:5433/rolefit"
DIRECT_URL="postgresql://rolefit:rolefit@127.0.0.1:5433/rolefit"

# --- Using Supabase (or any hosted Postgres) instead -----------------------
# Replace the two lines above. The app speaks plain Postgres through Prisma's
# pg driver adapter, so there is no vendor-specific driver to swap.
#
# In Supabase: Project Settings -> Database -> Connection string.
# You need TWO different strings from that page, and they are not
# interchangeable:
#
#   DATABASE_URL = Transaction pooler, port 6543, plus ?pgbouncer=true
#                  (the running app; every serverless request is a new process)
#   DIRECT_URL   = Session pooler,     port 5432
#                  (migrations only; they open long sessions and issue DDL,
#                   which a transaction pooler cannot carry)
#
# Use the SESSION POOLER for DIRECT_URL — not the "Direct connection" option.
# That host (db.<ref>.supabase.co) is IPv6-only on the free tier and fails to
# resolve on IPv4-only home networks and CI runners, with a "could not
# translate host name" error that looks like a typo but is not.
#
# Percent-encode special characters in the password: @ becomes %40. An
# un-encoded one silently truncates the URL and reports an auth failure that
# has nothing to do with the password being wrong.
#
#   DATABASE_URL="postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"
#
# Then:  npm run db:check && npm run db:migrate && npm run db:seed
# `db:check` verifies both URLs and tells you which one is wrong if either is.
# Full walkthrough with the failure modes: docs/DATABASE.md

# --- Auth (required) -------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public origin. Used for OAuth callbacks and absolute URLs in metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- GitHub OAuth (optional) ----------------------------------------------
# Omit both and the GitHub button hides itself; email/password still works.
# Create at https://github.com/settings/developers
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Anthropic (optional) --------------------------------------------------
# Without a key the app runs every analysis from deterministic fixtures, so the
# full flow is clickable at zero cost. With a key, real analyses run and
# fixtures are used only for the seeded demo account.
ANTHROPIC_API_KEY=""

# Forces fixture-backed analyses even when ANTHROPIC_API_KEY is set. Set this
# on a public demo deployment so visitors cannot spend your credits.
ROLEFIT_FORCE_DEMO_MODE="false"

# --- Limits (optional, sensible defaults shown) ----------------------------
# Analyses per calendar month on the free tier.
ROLEFIT_FREE_MONTHLY_ANALYSES="5"

# Short-window burst limit on AI routes, as requests per minute per user.
ROLEFIT_AI_RATE_LIMIT_PER_MINUTE="6"

# Comma-separated emails granted the admin usage dashboard on first sign-in.
ROLEFIT_ADMIN_EMAILS=""
okay